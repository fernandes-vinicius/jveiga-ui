{
  "name": "@fernandes-vinicius/jveiga-ui",
  "version": "0.1.0",
  "description": "Componentes construídos com shadcn/ui + Radix + CVA como scaffolding interno; compilado (tsdown) e publicado como pacote npm real, importado direto pelos apps consumidores (roadmap passo 3-4).",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fernandes-vinicius/jveiga-ui.git",
    "directory": "packages/ui"
  },
  "scripts": {
    "build": "tsdown",
    "lint": "biome check .",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fernandes-vinicius/jveiga-icons": "workspace:*",
    "@fernandes-vinicius/jveiga-tokens": "workspace:*",
    "@fernandes-vinicius/jveiga-utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "radix-ui": "^1.4.3",
    "react-day-picker": "^10.0.1",
    "sonner": "^2.0.8"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.5.9",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "jsdom": "^30.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsdown": "^0.22.14",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
